; Projet Godot 4.3 - C.A.D.I.S WARS v13 (chargement et scènes smoke-testés ; voir README_PROGRESSION.md)
config_version=5

[application]
config/name="C.A.D.I.S WARS"
config/description="C.A.D.I.S WARS : jeu d'action 3D Android (Godot 4.3, GDScript)"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/quit_on_go_back=false
boot_splash/show_image=false
config/icon="res://icons/icon.png"

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
WeaponManager="*res://scripts/autoload/weapon_manager.gd"
VehicleManager="*res://scripts/autoload/vehicle_manager.gd"
NPCManager="*res://scripts/autoload/npc_manager.gd"
WorldManager="*res://scripts/autoload/world_manager.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="civilian"
3d_physics/layer_5="vehicle"
3d_physics/layer_6="pickup"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
