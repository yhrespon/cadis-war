[resource]
script = ExtResource("1")
id = "pa_01_contact"
title = "Premier contact"
category = "main"
mission_type = "contact"
city = "port_alpha"
giver = "Inspecteur Roux"
briefing = "Un contact vous attend au carrefour central. Allez le voir : il a une arme à vous confier."
