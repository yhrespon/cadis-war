objectives = [{"type": "interact", "npc": "Roux", "poi": "contact_a", "text": "Parlez à Roux", "lines": ["Tu es le nouveau ? Prends ça, tu en auras besoin.", "Les hommes de Vance tiennent la zone nord-est. On commence par eux."]}]
